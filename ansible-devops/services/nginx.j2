server {
    listen 80;
    server_name klewn-devops.duckdns.org;
    # Αυτόματο redirect από HTTP σε HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name klewn-devops.duckdns.org;

    # Διαδρομές προς τα πιστοποιητικά που φτιάξαμε με το Certbot
    ssl_certificate /etc/letsencrypt/live/klewn-devops.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/klewn-devops.duckdns.org/privkey.pem;

    # Ρυθμίσεις ασφαλείας SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    location / {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Προσθήκη για το Mailhog (αν το τρέχεις native)
    location /mail/ {
        proxy_pass http://127.0.0.1:8025/;
    }

    # Προσθήκη για το Adminer
    location /db/ {
        proxy_pass http://127.0.0.1:8081/;
    }
}